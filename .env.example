DEBUG=True
SECRET_KEY=replace-this-for-deployment
# Vercel also accepts DJANGO_SECRET_KEY and defaults DEBUG to False.
# DJANGO_SECRET_KEY=replace-this-for-vercel
ALLOWED_HOSTS=localhost,127.0.0.1
# CSRF_TRUSTED_ORIGINS=https://your-domain.example
# Optional PostgreSQL: set DATABASE_URL (the driver is already installed)
# DATABASE_URL=postgresql://user:password@localhost:5432/mamudi
# ADMIN_USERNAME=admin
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=choose-a-strong-password
# DEMO_CUSTOMER_PASSWORD=choose-a-demo-password
# Email defaults to the console for local password reset demos.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
